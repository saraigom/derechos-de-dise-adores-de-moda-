# Copia este archivo como .env.local para desarrollo y configura las mismas
# variables en Vercel (Project Settings → Environment Variables).

# Obligatoria: créala gratis en https://openrouter.ai/keys
OPENROUTER_API_KEY=tu_clave_de_openrouter

# Opcional: modelo de OpenRouter. Debe ser gratuito (termina en ":free").
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Opcional: URL pública del despliegue (se envía a OpenRouter como referer).
NEXT_PUBLIC_SITE_URL=https://tu-proyecto.vercel.app
